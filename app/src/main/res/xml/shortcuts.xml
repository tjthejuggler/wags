<?xml version="1.0" encoding="utf-8"?>
<!--
    Static launcher shortcuts — one per top-level section of the app.
    Each shortcut launches MainActivity with ACTION_OPEN_SECTION and a
    "section" extra that SectionShortcutBus maps to a nav route.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="apnea"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_apnea"
        android:shortcutShortLabel="@string/shortcut_apnea_short"
        android:shortcutLongLabel="@string/shortcut_apnea_long">
        <intent
            android:action="com.example.wags.action.OPEN_SECTION"
            android:targetPackage="com.example.wags"
            android:targetClass="com.example.wags.MainActivity">
            <extra android:name="section" android:value="apnea" />
        </intent>
    </shortcut>

    <shortcut
